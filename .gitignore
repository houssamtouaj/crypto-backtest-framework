.idea/
__pycache__/
*.pyc
.pytest_cache/
/data/**
!/data/**/
!/data/**/manifest.json
# run outputs stay ignored except the Phase 8 step-7 files; the primary report.md files are added with -f
/runs/**
!/runs/**/
!/runs/summary.md
!/runs/registry.jsonl
!/runs/results.parquet
# trend: the screen result (Phase 2) and the summary
!/runs/trend/screen.json
!/runs/trend/summary.md
# carry: the Phase 0 basis sanity check
!/runs/carry/basis_check.json
# carry: the screen result (Phase 2) and the summary
!/runs/carry/screen.json
!/runs/carry/summary.md
# carry: the Phase 5 registry, results table, every stats.json and the holdout marker (Phase 7 commits them)
!/runs/carry/registry.jsonl
!/runs/carry/results.parquet
!/runs/carry/*/stats.json
!/runs/carry/holdout/*/stats.json
!/runs/carry/forward/*/stats.json
!/runs/carry/holdout/DONE
# carry: the Phase 6 reports and their figures (one per portfolio run; Phase 7 commits them)
!/runs/carry/*/report.md
!/runs/carry/*/figures/*.png
!/runs/carry/holdout/*/report.md
!/runs/carry/holdout/*/figures/*.png
!/runs/carry/forward/*/report.md
!/runs/carry/forward/*/figures/*.png
# etf: the screen result (Phase 2) and the summary
!/runs/etf/screen.json
!/runs/etf/summary.md
*.egg-info/
build/
dist/
.superpowers/
# etf: stores retired by `perpbt etf fetch --refetch` stay local
/data/etf/_old/
